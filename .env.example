# ─── Learn Dispatch URLs ───────────────────────────────────────────────────
NEXT_PUBLIC_LEARN_DISPATCH_URL=https://learndispatch.alphasolutions.software
NEXT_PUBLIC_SITE_URL=https://www.alphasolutions.software
# Do NOT set NEXT_PUBLIC_PORTAL_URL on this app — OAuth must stay on Learn Dispatch.
#
# Supabase Dashboard → Authentication → URL Configuration:
#   Site URL can stay portal if shared, BUT Redirect URLs MUST include:
#   https://learndispatch.alphasolutions.software/auth/callback
#   http://localhost:3000/auth/callback  (local)

# ─── Supabase (same project as Portal / TMS) ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── Staff who can verify NayaPay payments at /admin/enrollments ───────────
ADMIN_EMAILS=you@example.com,teammate@example.com

# ─── Vercel Cron (expire paid enrollments nightly) ─────────────────────────
# Generate: openssl rand -hex 32
CRON_SECRET=generate_a_long_random_string

# ─── Cloudflare R2 (private lesson videos, signed URLs) ────────────────────
# Dashboard → R2 → Manage R2 API Tokens → Create API token (Object Read)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=learn-dispatch-videos

# ─── Groq AI (student assistant + instructor drafts) ───────────────────────
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# ─── SMTP (enrollment, payment, quiz, certificate, chat alerts) ────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_app_password
SMTP_FROM=Learn Dispatch <no-reply@alphasolutions.software>
ACADEMY_SUPPORT_EMAIL=support@freight.alphasolutions.software
# Optional secret used to sign certificate audit hashes
CERTIFICATE_SIGNING_SECRET=generate_a_long_random_string
# Instructor inboxes for chat + ops alerts (comma-separated). Falls back to ADMIN_EMAILS.
ACADEMY_INSTRUCTOR_NOTIFY_EMAIL=instructor@example.com
AUTH_OPS_NOTIFY_EMAIL=ops@example.com
